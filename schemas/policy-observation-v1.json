      "properties": {
        "schema_version": {
          "const": 1
        },
        "licenses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow"
          ],
          "properties": {
            "allow": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "advisories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exceptions"
          ],
          "properties": {
            "exceptions": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "owner",
                  "reason",
                  "expires"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^RUSTSEC-[0-9]{4}-[0-9]{4}$"
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "expires": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                }
              }
            }
          }
        },
