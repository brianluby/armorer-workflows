{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://armorer.dev/schemas/policy-observation-v1.json",
  "title": "Unsigned independent policy observation v1",
  "description": "Structural validation only; does not authenticate a producer, grant signing authority or establish SLSA compliance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "source",
    "runtime_commit",
    "run_id",
    "run_attempt",
    "event",
    "ref",
    "selection",
    "scope",
    "observed",
    "effective_policy",
    "runtime_inputs",
    "tool_catalog",
    "tools",
    "reports",
    "checks",
    "signing_authorized",
    "producer_job_authenticated",
    "cryptographic_release_authenticated"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state": {
      "const": "passing-unsigned-policy-observation"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "runtime_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "run_attempt": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "event": {
      "enum": [
        "pull_request",
        "push",
        "workflow_dispatch"
      ]
    },
    "ref": {
      "type": "string",
      "pattern": "^refs/(heads|tags|pull)/[A-Za-z0-9_./-]+$",
      "maxLength": 512
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "package",
        "binary",
        "targets",
        "target",
        "feature_set",
        "default_features",
        "features",
        "runner",
        "artifact_id",
        "toolchain"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "profile": {
          "enum": [
            "library",
            "cli",
            "service"
          ]
        },
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "binary": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64-unknown-linux-gnu",
              "aarch64-unknown-linux-gnu",
              "aarch64-apple-darwin"
            ]
          }
        },
        "target": {
          "enum": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "aarch64-apple-darwin"
          ]
        },
        "feature_set": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "default_features": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]{0,99}$"
          }
        },
        "runner": {
          "enum": [
            "ubuntu-24.04",
            "ubuntu-24.04-arm",
            "macos-15"
          ]
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 239
        },
        "toolchain": {
          "const": "1.95.0"
        }
      }
    },
    "scope": {
      "const": "cargo-workspace-with-explicit-target-and-features"
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at"
      ],
      "properties": {
        "started_at": {
          "type": "integer",
          "minimum": 1
        },
        "finished_at": {
          "type": "integer",
          "minimum": 1
