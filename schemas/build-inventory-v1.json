{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brianluby/armorer-workflows/schemas/build-inventory-v1.json",
  "title": "Unsigned Armorer build inventory version 1",
  "description": "Consistency evidence, not an authenticated release or provenance statement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "signing_status",
    "provenance_status",
    "source",
    "runtime_commit",
    "run_id",
    "run_attempt",
    "selection",
    "input_sha256",
    "source_input_sha256",
    "tool_sha256",
    "tool_pin_authority",
    "graph_scope",
    "coverage_gaps",
    "artifact_kind",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state": {
      "const": "build-produced"
    },
    "signing_status": {
      "const": "unsigned"
    },
    "provenance_status": {
      "const": "not-attested"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "runtime_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      ]
    },
    "run_attempt": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "package",
        "binary",
        "targets",
        "target",
        "feature_set",
        "default_features",
        "features",
        "runner",
        "artifact_id",
        "toolchain"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "profile": {
          "enum": [
            "library",
            "cli",
            "service"
          ]
        },
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "binary": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64-unknown-linux-gnu",
              "aarch64-unknown-linux-gnu",
              "aarch64-apple-darwin"
            ]
          }
        },
        "target": {
          "enum": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "aarch64-apple-darwin"
          ]
        },
        "feature_set": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "default_features": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]{0,99}$"
          }
        },
        "runner": {
          "enum": [
            "ubuntu-24.04",
            "ubuntu-24.04-arm",
            "macos-15"
          ]
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 239
        },
        "toolchain": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "armorer.toml",
        "armorer.lock",
        "Cargo.lock"
      ],
      "properties": {
        "armorer.toml": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "armorer.lock": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "Cargo.lock": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_input_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "tool_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "tool_pin_authority": {
      "const": "immutable-trusted-workflow-catalog"
    },
    "graph_scope": {
      "const": "compiled-cargo-target-and-host-build-dependencies"
    },
    "coverage_gaps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_kind": {
      "enum": [
        "source-package",
        "executable"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "size",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$"
          },
          "role": {
            "enum": [
              "artifact",
              "sbom",
              "cargo-graph"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
