{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brianluby/armorer-workflows/schemas/unsigned-handoff-v3.json",
  "title": "Explicit unsigned build handoff v3",
  "description": "Unsigned consistency/observation only; transport authentication and signing are separate mandatory gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "runtime_commit",
    "selection",
    "input_sha256",
    "tool_sha256",
    "schema_version",
    "state",
    "signing_status",
    "provenance_status",
    "run_id",
    "run_attempt",
    "build_inventory",
    "root_component_name",
    "package_version",
    "observed_build"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "runtime_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "package",
        "binary",
        "targets",
        "target",
        "feature_set",
        "default_features",
        "features",
        "runner",
        "artifact_id",
        "toolchain"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "profile": {
          "enum": [
            "library",
            "cli",
            "service"
          ]
        },
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "binary": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64-unknown-linux-gnu",
              "aarch64-unknown-linux-gnu",
              "aarch64-apple-darwin"
            ]
          }
        },
        "target": {
          "enum": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "aarch64-apple-darwin"
          ]
        },
        "feature_set": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "default_features": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]{0,99}$"
          }
        },
        "runner": {
          "enum": [
            "ubuntu-24.04",
            "ubuntu-24.04-arm",
            "macos-15"
          ]
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 239
        },
        "toolchain": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "armorer.toml",
        "armorer.lock",
        "Cargo.lock"
      ],
      "properties": {
        "armorer.toml": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "armorer.lock": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "Cargo.lock": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tool_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "schema_version": {
      "const": 3
    },
    "state": {
      "const": "unsigned-handoff"
    },
    "signing_status": {
      "const": "unsigned"
    },
    "provenance_status": {
      "const": "not-attested"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "run_attempt": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "build_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "root_component_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "observed_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at"
      ],
      "properties": {
        "started_at": {
          "type": "integer",
          "minimum": 1
        },
        "finished_at": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
